# Copy this file to .env and fill in what you actually have.
# Nothing here is required to run the app -- every value has a safe dev default,
# and any missing "Future Enhancement" key simply keeps that one integration disabled
# (it does not crash the app -- see backend/app/external_feeds/stub_feeds.py).

# --- Database -----------------------------------------------------------
# Default: local SQLite file. Swap to a Postgres URL to move off SQLite --
# no code changes needed, only this variable (see docker-compose.yml comments).
DATABASE_URL=sqlite:///./hmt.db

# --- CORS -----------------------------------------------------------------
# Comma-separated list of origins the frontend is served from.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Live public feeds (real, no key needed) -------------------------------
# ReliefWeb asks that API consumers identify themselves via an `appname` query
# param (not a secret, no signup) -- change it to your own project name if you
# want ReliefWeb's own logs to show your project rather than ours.
RELIEFWEB_APPNAME=hmt-capstone-project

# --- Future Enhancement -- credentialed sources (NOT wired to real calls) --
# These stay disabled (FeedNotConfiguredError, reported as "not_configured"
# in /api/feeds/status) until you obtain and set the credentials below.
# See STATUS.md for why these weren't obtained during this build.
# NEWS_API_KEY=
# GOOGLE_FACT_CHECK_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
